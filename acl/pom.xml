<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acs.brunsi</groupId>
        <artifactId>sandbox</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sandbox.acl</artifactId>
    <packaging>content-package</packaging>
    <name>Brunsi's Sandbox - ACL</name>
    <description>ACL package for Brunsi's Sandbox</description>

    <!-- B U I L D   D E F I N I T I O N   -->
    <build>
        <sourceDirectory>src/main/content/jcr_root</sourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <showImportPackageReport>false</showImportPackageReport>
                    <group>com.acs.brunsi</group>
                    <name>sandbox.acl</name>
                    <packageType>application</packageType>
                    <repositoryStructurePackages>
                        <repositoryStructurePackage>
                            <groupId>com.acs.brunsi</groupId>
                            <artifactId>sandbox.ui.apps.structure</artifactId>
                        </repositoryStructurePackage>
                    </repositoryStructurePackages>
                    <properties>
                        <installhook.actool.class>biz.netcentric.cq.tools.actool.installhook.AcToolInstallHook
                        </installhook.actool.class>
                        <cloudManagerTarget>none</cloudManagerTarget>
                    </properties>
                    <validatorsSettings>
                        <jackrabbit-packagetype>
                            <isDisabled>true</isDisabled>
                        </jackrabbit-packagetype>
                    </validatorsSettings>
                    <dependencies>
                        <dependency>
                            <groupId>com.acs.brunsi</groupId>
                            <artifactId>sandbox.ui.apps</artifactId>
                            <version>${project.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>com.acs.brunsi</groupId>
                            <artifactId>sandbox.ui.content</artifactId>
                            <version>${project.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>biz.netcentric.cq.tools.accesscontroltool</groupId>
                            <artifactId>accesscontroltool-package</artifactId>
                            <classifier>cloud</classifier>
                        </dependency>
                    </dependencies>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.day.jcr.vault</groupId>
                <artifactId>content-package-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.acs.brunsi</groupId>
            <artifactId>sandbox.ui.apps</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.acs.brunsi</groupId>
            <artifactId>sandbox.ui.content</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>biz.netcentric.cq.tools.accesscontroltool</groupId>
            <artifactId>accesscontroltool-package</artifactId>
            <type>zip</type>
            <classifier>cloud</classifier>
        </dependency>
        <dependency>
            <groupId>com.acs.brunsi</groupId>
            <artifactId>sandbox.ui.apps.structure</artifactId>
            <type>zip</type>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
